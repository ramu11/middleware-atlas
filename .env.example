# Middleware Atlas local development configuration.
# Copy to .env for local overrides. Never commit real credentials or customer data.

# Optional absolute project root. Normally detected from the Rust workspace.
ATLAS_PROJECT_DIR=
# Optional TOML config path; relative paths are resolved against ATLAS_PROJECT_DIR.
ATLAS_CONFIG_FILE=

# Optional overrides; values in config/default.toml are used when these are blank.
ATLAS_BIND_ADDR=127.0.0.1:8080
ATLAS_WEB_ORIGIN=http://localhost:3000
ATLAS_DATA_DIR=data
ATLAS_MAX_UPLOAD_BYTES=107374182400
ATLAS_DB_MAX_CONNECTIONS=5
ATLAS_DB_BUSY_TIMEOUT_SECONDS=10

# Dify credentials stay server-side and are intentionally not included in TOML.
ATLAS_DIFY_BASE_URL=http://127.0.0.1
ATLAS_DIFY_API_KEY=
ATLAS_DIFY_APP_ID=
ATLAS_MAT_HOME=
ATLAS_MAT_MAX_CONCURRENT_JOBS=1
