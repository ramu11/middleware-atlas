# Middleware Atlas local development configuration.
# Copy to .env and fill in values for your own environment.
# Never commit real credentials.

ATLAS_BIND_ADDR=127.0.0.1:8080
ATLAS_DATA_DIR=./data

# Dify deployment. Use the base URL for your own Dify instance.
ATLAS_DIFY_BASE_URL=http://127.0.0.1
ATLAS_DIFY_API_KEY=
# Configure the application/workflow identifier required by the selected API.
ATLAS_DIFY_APP_ID=

# Optional Eclipse MAT installation.
ATLAS_MAT_HOME=
ATLAS_MAT_MAX_CONCURRENT_JOBS=1
